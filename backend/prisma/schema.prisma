generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Las dos entidades jurídicas que opera el negocio (La Llar y Confia
// Alimentos). Una factura o un vale se emite a exactamente UNA de ellas, y
// los resúmenes deben poder segmentarse por empresa.
//
// Es un catálogo extensible, no un enum: el negocio puede dar de alta una
// tercera razón social sin migración, y desactivar una empresa la saca de
// los formularios sin borrar un solo histórico (soft delete, como el resto
// de catálogos del sistema).
//
// Los proveedores NO pertenecen a una empresa: son un catálogo global y la
// empresa vive en la factura, porque un mismo proveedor factura a ambas.
model empresas {
  id     Int     @id @default(autoincrement())
  nombre String  @unique @db.VarChar(120)
  activo Boolean @default(true)

  sucursales sucursales[]
  facturas   facturas[]
  // La relación inversa de vales llega con la spec 002.
}

model usuarios {
  id           Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(150)
  email        String   @unique @db.VarChar(200)
  password     String   @db.VarChar(255)
  rol          Rol
  activo       Boolean  @default(true)
  sucursal_id  Int?
  proveedor_id Int?
  creado_en    DateTime @default(now())

  sucursal  sucursales?  @relation(fields: [sucursal_id], references: [id])
  proveedor proveedores? @relation(fields: [proveedor_id], references: [id])
}

model sucursales {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(150)
  activo Boolean @default(true)

  // Días laborales de la unidad, como números ISO separados por coma
  // (1=Lunes … 7=Domingo). Determina qué días cuentan como falta cuando
  // no hay registro ni justificación. Por defecto lunes a sábado.
  dias_laborales String @default("1,2,3,4,5,6") @db.VarChar(20)

  // Empresa a la que pertenece la unidad. De aquí se deriva la empresa por
  // defecto de un gerente (que está acotado a su sucursal). Es opcional a
  // nivel de columna para no romper la migración sobre los datos que ya
  // existen: el backfill la puebla (scripts/backfill_empresas_sucursales.js).
  empresa_id Int?

  empresa           empresas?           @relation(fields: [empresa_id], references: [id])
  usuarios          usuarios[]
  empleados         empleados[]
  asistencias       asistencias[]
  documentos_unidad documentos_unidad[]
}

model empleados {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(150)
  lector_uid  String   @db.VarChar(100)
  sucursal_id Int
  activo      Boolean  @default(true)
  creado_en   DateTime @default(now())

  // Datos personales básicos (nómina). Opcionales para no romper altas
  // rápidas ni registros previos. RFC persona física = 13, CURP = 18.
  fecha_nacimiento DateTime? @db.Date
  rfc              String?   @db.VarChar(13)
  curp             String?   @db.VarChar(18)

  sucursal        sucursales                @relation(fields: [sucursal_id], references: [id])
  asistencias     asistencias[]
  justificaciones justificaciones[]
  correcciones    correcciones_asistencia[]

  // El lector_uid es único POR unidad, no globalmente: el checador de cada
  // cocina puede asignar el mismo número a empleados distintos. El webhook
  // resuelve al empleado por (lector_uid, sucursal_id).
  @@unique([lector_uid, sucursal_id])
}

model asistencias {
  id          Int            @id @default(autoincrement())
  empleado_id Int
  sucursal_id Int
  tipo        TipoAsistencia
  timestamp   DateTime       @default(now())

  empleado empleados  @relation(fields: [empleado_id], references: [id])
  sucursal sucursales @relation(fields: [sucursal_id], references: [id])

  // Clave natural para idempotencia: un checador no produce dos marcas
  // idénticas (mismo empleado, tipo y segundo). Evita duplicados cuando el
  // agente reenvía una marca que el backend ya había guardado (entrega
  // at-least-once tras un timeout posterior al commit).
  @@unique([empleado_id, tipo, timestamp])
}

model justificaciones {
  id          Int               @id @default(autoincrement())
  empleado_id Int
  fecha       String            @db.VarChar(10) // 'YYYY-MM-DD' — sin zona horaria
  tipo        TipoJustificacion
  nota        String?           @db.VarChar(300)
  creado_por  Int
  creado_en   DateTime          @default(now())

  empleado empleados @relation(fields: [empleado_id], references: [id])

  @@unique([empleado_id, fecha])
}

// Capa de corrección del administrador. NO altera las marcas crudas del
// checador (tabla `asistencias`); las sobreescribe a nivel de día para la
// vista. entrada/salida en 'HH:MM'; null = el admin dejó el campo vacío.
model correcciones_asistencia {
  id            Int      @id @default(autoincrement())
  empleado_id   Int
  fecha         String   @db.VarChar(10) // 'YYYY-MM-DD'
  entrada       String?  @db.VarChar(5) // 'HH:MM'
  salida        String?  @db.VarChar(5) // 'HH:MM'
  corregido_por Int
  creado_en     DateTime @default(now())

  empleado empleados @relation(fields: [empleado_id], references: [id])

  @@unique([empleado_id, fecha])
}

model proveedores {
  id        Int      @id @default(autoincrement())
  nombre String  @db.VarChar(150)
  // Único: el RFC identifica fiscalmente al proveedor, y con el alta por link
  // (spec 001 HU-1) el catálogo ya no lo llena solo el administrador. Sin esta
  // restricción, dos registros simultáneos con el mismo RFC crearían dos
  // proveedores gemelos y las facturas se repartirían entre ambos.
  // Sigue admitiendo NULL —y MySQL permite varios— para los proveedores que
  // el administrador da de alta sin RFC a mano.
  rfc       String?  @unique @db.VarChar(20)
  activo    Boolean  @default(true)
  creado_en DateTime @default(now())

  // Días naturales entre la aprobación de una factura y su fecha de pago
  // estimada. Son fijos por proveedor, no por empresa (spec 001 §7): el
  // mismo proveedor cobra al mismo plazo facture a La Llar o a Confia.
  //
  // NULL y 0 no son lo mismo, y por eso la columna admite nulos: 0 es "paga
  // de contado", una condición comercial que alguien decidió; NULL es "nadie
  // lo ha configurado todavía". El resumen semanal calcula igual con los dos
  // (HU-10: sin configurar se asume 0), pero solo marca los NULL como
  // pendientes de configurar. Con un `@default(0)` no nulo, cada proveedor
  // de contado saldría marcado como "sin configurar" todas las semanas.
  dias_credito Int?

  // Bloqueo puntual: freno manual del administrador para un proveedor
  // problemático (spec 001 HU-8). Es distinto de `activo`: un proveedor
  // bloqueado sigue existiendo, entrando al sistema y viendo su historial;
  // lo único que no puede es subir facturas nuevas. El motivo es obligatorio
  // al bloquear porque el proveedor lo ve: un 403 sin explicación acaba en
  // una llamada telefónica.
  bloqueado_facturar Boolean @default(false)
  motivo_bloqueo     String? @db.VarChar(300)

  usuarios             usuarios[]
  documentos_proveedor documentos_proveedor[]
  facturas             facturas[]
}

model documentos_proveedor {
  id              Int             @id @default(autoincrement())
  proveedor_id    Int
  nombre_original String          @db.VarChar(255)
  ruta_archivo    String          @db.VarChar(500)
  tipo_mime       String          @db.VarChar(100)
  subido_por      Int
  estado          EstadoDocumento @default(pendiente)
  creado_en       DateTime        @default(now())

  proveedor proveedores @relation(fields: [proveedor_id], references: [id])
}

model documentos_unidad {
  id              Int             @id @default(autoincrement())
  sucursal_id     Int
  nombre_original String          @db.VarChar(255)
  ruta_archivo    String          @db.VarChar(500)
  tipo_mime       String          @db.VarChar(100)
  subido_por      Int
  estado          EstadoDocumento @default(pendiente)
  creado_en       DateTime        @default(now())

  sucursal sucursales @relation(fields: [sucursal_id], references: [id])
}

// Archivo histórico: documentos que el administrador saca del flujo activo
// de Proveedores/Unidades ("Mandar a Histórico") y quedan como registro
// permanente. Se conserva la fecha original de subida (subido_en), quién
// subió el archivo (subido_por) y quién aprobó el envío (aprobado_por).
// origen_nombre se desnormaliza para que el histórico sobreviva a renombres
// o bajas del proveedor/unidad y para poder buscar sin JOINs.
model documentos_historicos {
  id              Int             @id @default(autoincrement())
  origen          OrigenDocumento
  origen_id       Int
  origen_nombre   String          @db.VarChar(150)
  nombre_original String          @db.VarChar(255)
  ruta_archivo    String          @db.VarChar(500)
  tipo_mime       String          @db.VarChar(100)
  subido_por      Int
  subido_en       DateTime
  aprobado_por    Int
  enviado_en      DateTime        @default(now())

  @@index([origen])
  @@index([nombre_original])
}

// Factura CFDI de un proveedor. Convive con `documentos_proveedor`, que
// sigue siendo el cajón de documentación genérica (constancias, contratos):
// una factura tiene folio fiscal, importe y un ciclo de vida propio que un
// documento suelto no tiene, y mezclarlas obligaría a llenar de columnas
// nulas la tabla genérica.
//
// El par XML + PDF es obligatorio: el XML es el comprobante fiscal de verdad
// (de él se extrae todo lo demás) y el PDF es la representación impresa que
// revisa una persona. Guardar solo uno de los dos deja el expediente cojo.
model facturas {
  id           Int    @id @default(autoincrement())
  proveedor_id Int
  empresa_id   Int

  // Folio fiscal del timbre (TimbreFiscalDigital/@UUID). Es la clave natural
  // de deduplicación del sistema entero: el SAT garantiza que no se repite,
  // así que dos filas con el mismo UUID son la misma factura subida dos veces.
  uuid_fiscal String @unique @db.VarChar(36)

  rfc_emisor   String? @db.VarChar(13)
  rfc_receptor String? @db.VarChar(13)

  // Decimal, nunca Float: en dinero, 0.1 + 0.2 no puede dar 0.30000000000000004.
  total       Decimal   @db.Decimal(12, 2)
  fecha_cfdi  DateTime?
  serie_folio String?   @db.VarChar(60)
  moneda      String?   @db.VarChar(3)

  estado EstadoDocumento @default(pendiente)

  ruta_xml String @db.VarChar(500)
  ruta_pdf String @db.VarChar(500)

  // Nombres originales con los que el proveedor subió cada archivo. En disco
  // todo se guarda como UUID + extensión canónica (nunca el nombre del
  // cliente), pero al descargar hay que devolverle su nombre.
  nombre_xml String @db.VarChar(255)
  nombre_pdf String @db.VarChar(255)

  subido_por       Int
  aprobado_por     Int?
  // Arranca el conteo de días de crédito: fecha de pago = esta + dias_credito.
  fecha_aprobacion DateTime?

  // Ciclo del complemento de pago (HU-4): el admin marca que ya pagó y eso
  // obliga al proveedor a subir el complemento antes de facturar de nuevo.
  pago_realizado     Boolean   @default(false)
  fecha_pago_marcado DateTime?

  creado_en DateTime @default(now())

  proveedor     proveedores               @relation(fields: [proveedor_id], references: [id])
  empresa       empresas                  @relation(fields: [empresa_id], references: [id])
  observaciones observaciones_documento[]
  complemento   complementos_pago?

  @@index([proveedor_id, estado])
  @@index([empresa_id, fecha_aprobacion])
  // El bloqueo secuencial pregunta justo por esto: facturas pagadas de un
  // proveedor que todavía no tienen complemento.
  @@index([proveedor_id, pago_realizado])
}

// Complemento de pago de una factura ya pagada. Uno por factura (@unique en
// factura_id): el complemento cierra el ciclo fiscal de ESA factura.
//
// El UUID es opcional a diferencia del de la factura: un complemento de pago
// es un CFDI timbrado y debería traerlo, pero si el XML llega sin timbre
// preferimos guardar el documento y que el administrador lo rechace a mano
// antes que perderlo. Cuando viene, también es único.
model complementos_pago {
  id          Int     @id @default(autoincrement())
  factura_id  Int     @unique
  uuid_fiscal String? @unique @db.VarChar(36)

  ruta_xml   String @db.VarChar(500)
  ruta_pdf   String @db.VarChar(500)
  nombre_xml String @db.VarChar(255)
  nombre_pdf String @db.VarChar(255)

  estado     EstadoDocumento @default(pendiente)
  subido_por Int
  creado_en  DateTime        @default(now())

  factura facturas @relation(fields: [factura_id], references: [id])
}

// Observaciones de una factura. Es una tabla y no una columna `observacion`
// porque el rechazo puede repetirse: el proveedor corrige, vuelve a subir,
// y el historial de por qué se le rechazó cada vez es justamente lo que hace
// auditable la relación. Solo se añaden filas; nunca se editan ni se borran.
model observaciones_documento {
  id         Int      @id @default(autoincrement())
  factura_id Int
  texto      String   @db.VarChar(500)
  autor_id   Int
  creado_en  DateTime @default(now())

  factura facturas @relation(fields: [factura_id], references: [id])

  @@index([factura_id])
}

// Invitación de un solo uso para que un proveedor se dé de alta solo.
//
// Se guarda el HASH del token, no el token: la tabla es tan legible para
// quien tenga acceso a la base como para un respaldo extraviado, y un token
// en claro ahí dentro es una cuenta de proveedor regalada. El token viaja
// una única vez, en la URL que el administrador copia.
model invitaciones_proveedor {
  id         Int       @id @default(autoincrement())
  token_hash String    @unique @db.VarChar(64)
  email      String?   @db.VarChar(200)
  creada_por Int
  expira_en  DateTime
  usado_en   DateTime?
  creado_en  DateTime  @default(now())

  @@index([expira_en])
}

// Ajustes sueltos del sistema que no justifican una tabla propia: hoy solo
// el "ejemplo de factura" que el administrador publica para los proveedores
// (spec 001 HU-7), un PDF que se reemplaza de vez en cuando.
//
// Clave/valor con el valor en JSON, a propósito: la alternativa era una
// tabla `ejemplos_factura` de una sola fila, o guardar la metadata en un
// archivo suelto junto al PDF, que es justo lo que se desincroniza.
model configuracion {
  clave         String   @id @db.VarChar(60)
  valor         Json
  actualizado_por Int?
  actualizado_en  DateTime @updatedAt
}

model ventanas_carga {
  id      Int       @id @default(autoincrement())
  modulo  Modulo    @unique
  abierta Boolean   @default(false)
  desde   DateTime?
  hasta   DateTime?
}

enum Rol {
  administrador
  gerente
  proveedor
}

enum TipoAsistencia {
  entrada
  salida
}

enum TipoJustificacion {
  vacaciones
  incapacidad
  permiso
  falta_justificada
}

enum Modulo {
  proveedores
  unidades
  // Permiso temporal para que los gerentes editen asistencias de su unidad.
  asistencias
}

enum EstadoDocumento {
  pendiente
  aprobado
  desaprobado
}

enum OrigenDocumento {
  unidad
  proveedor
}
