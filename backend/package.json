{
  "name": "la-llar-backend",
  "version": "1.0.0",
  "description": "Backend API para sistema de gestión interna La Llar",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:watch": "node --test --test-concurrency=1 --watch \"tests/**/*.test.js\"",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:backfill-empresas": "node scripts/backfill_empresas_sucursales.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.2",
    "fast-xml-parser": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pdfmake": "^0.2.20",
    "uuid": "^11.1.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2"
